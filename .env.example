# Copy to backend/.env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (plain Postgres - no pgvector/extensions) ---
POSTGRES_DB=budget_insights_narrator
POSTGRES_USER=budget_insights_narrator
POSTGRES_PASSWORD=budget_insights_narrator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands (check,
# makemigrations, test) against local SQLite when Docker/Postgres aren't
# available, e.g. on a bare dev machine. Never set this in
# docker-compose/production. See backend/config/settings/base.py.
USE_SQLITE=True

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI (single chat-completion call, no embeddings/vector DB) ---
# Leave OPENAI_API_KEY unset for fully offline, deterministic stub
# narratives (default for local dev/tests). Set it to call the real
# OpenAI chat completions API in apps/common/ai.py.
# NOTE: this app's default chat model is gpt-5.4-mini - deliberately
# different from the gpt-5.6-sol default used by several sibling apps.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
